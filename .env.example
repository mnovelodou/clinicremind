# Copy to .env and fill in. The app reads these at startup.

# SQLAlchemy / Postgres connection URL. Must use the psycopg (v3) driver.
DATABASE_URL=postgresql+psycopg://clinicremind:clinicremind@localhost:5432/clinicremind

# Database used by integration tests (marked @pytest.mark.integration). Kept
# separate from DATABASE_URL so a test run never wipes development data. The
# default below matches the test DB created by docker-compose.yml.
TEST_DATABASE_URL=postgresql+psycopg://clinicremind:clinicremind@localhost:5432/clinicremind_test

# Flask session signing key. Use a long random value in any real environment.
SECRET_KEY=dev-only-change-me

# Optional: Flask environment (development/production). Defaults to production.
FLASK_DEBUG=1
